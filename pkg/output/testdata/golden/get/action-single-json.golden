{
  "appId": "example.connector",
  "actionName": "create-thing",
  "title": "Create thing",
  "description": "Creates a thing",
  "fullName": "example.connector:create-thing",
  "approval": true,
  "docs": {
    "inputSchema": {
      "type": "object",
      "required": [
        "owner"
      ]
    }
  },
  "expressionValidation": {
    "owner": {
      "pattern": "^[A-Za-z0-9-]+$"
    }
  },
  "widget": "/actions/create-thing"
}
